#!/bin/sh
set -e
ln -sf /usr/share/uraam/uraam.sh /usr/bin/uraam
chmod 0755 /usr/share/uraam/uraam.sh /usr/share/uraam/uraam-api.sh /usr/bin/uraam-gui
if python3 -c "import gi; gi.require_version('Gtk', '4.0'); from gi.repository import Gtk" >/dev/null 2>&1; then
    install -D -m 0644 /usr/share/uraam/uraam.desktop /usr/share/applications/uraam.desktop
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi
exit 0
